---
import "@/styles/global.css";

import Footer from "@components/Footer/Footer.astro";
import Nav from "@components/Nav/Nav.astro";
import BaseHead from "@layouts/BaseHead.astro";
import type { CmsEntry, CmsPage } from "@librepublish/astro/client";
import { getEntry } from "astro:content";

import { getSiteSettings, href } from "@/lib/cms";

interface Props {
	/** The CMS page or entry this page shows: its title and SEO panel fill the <head>. */
	record: CmsPage | CmsEntry;
	/** "white" keeps the nav white over a photo header until the page scrolls. */
	navStartStyle?: "default" | "white";
}

const { record, navStartStyle = "default" } = Astro.props as Props;
const [settings, scriptsGlobal] = await Promise.all([getSiteSettings(), getEntry("globals", "scripts")]);
const scriptItems = ((scriptsGlobal?.data as any)?.data?.items ?? []) as { body?: string; enabled?: boolean }[];
const bodyScripts = scriptItems.filter((s) => s.enabled !== false).map((s) => s.body).filter(Boolean).join("\n");
---

<!doctype html>
<html lang={record.locale || "en"} transition:animate="fade">
	<head>
		<BaseHead record={record} />
	</head>
	<body id="body" class="bg-base-50 text-base-900">
		<div class="min-h-[100lvh]">
			<Nav startStyle={navStartStyle} />
			<main>
				<slot />
			</main>
		</div>
		<Footer />

		<!-- sticky booking bar for small screens; motion.ts shows it between the hero and the contact form -->
		{
			settings.mobile_cta_label && (
				<div
					id="mobile-cta"
					inert
					class="border-base-200 bg-base-50/95 fixed inset-x-0 bottom-0 z-20 border-t px-4 pt-3 pb-[calc(0.75rem+env(safe-area-inset-bottom,0px))] opacity-0 backdrop-blur md:hidden"
					style="transform: translateY(120%)"
				>
					<a href={href(settings.booking_link) ?? "/#contact"} class="button button--primary w-full">
						{settings.mobile_cta_label}
					</a>
				</div>
			)
		}

		<script>
			import "@js/motion";
		</script>
		{bodyScripts && <Fragment set:html={bodyScripts} />}
	</body>
</html>
