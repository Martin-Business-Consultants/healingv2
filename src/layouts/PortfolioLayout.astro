---
import CmsImage from "@components/CmsImage/CmsImage.astro";
import Contact from "@components/Contact/Contact.astro";
import PortfolioGrid from "@components/Portfolio/PortfolioGrid.astro";
import TestimonialQuote from "@components/Testimonials/TestimonialQuote.astro";
import { Icon } from "astro-icon/components";
import { marked } from "marked";

import { type CaseStudy, getSiteSettings, listCaseStudies, plainText } from "@/lib/cms";

import BaseLayout from "./BaseLayout.astro";

interface Props {
	portfolio: CaseStudy;
}

const { portfolio } = Astro.props as Props;
const { description, location, hero_image, goal, challenges, solution, outcome, gallery = [] } = portfolio.frontmatter;

const cards = [
	{ icon: "tabler:target", title: "Goal", text: plainText(goal) },
	{ icon: "tabler:alert-triangle", title: "Challenges", text: plainText(challenges) },
	{ icon: "tabler:bulb", title: "Solution", text: plainText(solution) },
	{ icon: "tabler:plant-2", title: "Outcome", text: plainText(outcome) },
];

const rows = (gallery ?? []).map((row) => (row.images ?? []).map((item) => item.image).filter(Boolean)).filter((row) => row.length);
const body = portfolio.body_markdown?.trim() ? await marked.parse(portfolio.body_markdown) : "";
const otherPortfolios = (await listCaseStudies()).filter((other) => other.slug !== portfolio.slug);
const moreHeading = (await getSiteSettings()).case_study_page?.more_heading;
const record = {
	...portfolio,
	seo: {
		...portfolio.seo,
		meta_description: portfolio.seo?.meta_description || description,
		og_image_id: portfolio.seo?.og_image_id || hero_image,
	},
};
---

<BaseLayout record={record} navStartStyle="white">
	<div class="relative h-[50svh] w-full overflow-hidden md:h-[70svh]">
		<div class="absolute inset-0 z-10 bg-black/30"></div>
		<CmsImage
			id={hero_image}
			alt=""
			class="absolute inset-0 h-full w-full object-cover object-center"
			sizes="100vw"
			loading="eager"
			fetchpriority="high"
			transition:name={`portfolio-image-${portfolio.slug}`}
		/>
	</div>

	<article class="mx-auto mt-12 px-4 md:mt-20 md:max-w-6xl">
		<h1 class="h1 description mt-4 text-center uppercase">{portfolio.title}</h1>

		{
			location && (
				<h2 class="h3 text-primary-500 mt-10 flex flex-col items-center justify-center gap-x-3 gap-y-1 tracking-widest md:flex-row">
					<span>{location}</span>
				</h2>
			)
		}

		<!-- goal / challenges / solution / outcome cards -->
		<div class="mt-10 grid gap-6 sm:grid-cols-2 md:mt-16 md:gap-8">
			{
				cards.map((card) =>
					card.text ? (
						<div class="bg-base-100 rounded-md p-6 md:p-8">
							<div class="flex items-center gap-3">
								<Icon name={card.icon} class="text-primary-500 size-7 shrink-0" />
								<h3 class="h3 uppercase">{card.title}</h3>
							</div>
							<p class="description mt-4 text-pretty md:text-lg">{card.text}</p>
						</div>
					) : null,
				)
			}
		</div>

		{body && <div class="markdown-content mx-auto mt-12 max-w-3xl" set:html={body} />}

		<!-- photo rows: one, two or three photos side by side -->
		<div class="mx-auto mt-12 max-w-5xl space-y-6 md:mt-20 md:space-y-16">
			{
				rows.map((row) => (
					<div
						class:list={[
							"mb-6 grid gap-6 md:gap-16",
							{ "grid-cols-1": row.length === 1, "grid-cols-2": row.length === 2, "grid-cols-3": row.length >= 3 },
						]}
					>
						{row.map((image) => (
							<div class="h-full w-full max-w-6xl">
								<CmsImage
									id={image}
									sizes={`(min-width: 1024px) ${Math.round(1120 / row.length)}px, ${Math.round(100 / row.length)}vw`}
									class="h-auto min-h-full w-full min-w-full object-cover"
								/>
							</div>
						))}
					</div>
				))
			}
		</div>
	</article>

	<TestimonialQuote />

	{
		otherPortfolios.length > 0 && (
			<section class="mx-auto mt-12 px-4 md:mt-16 md:max-w-5xl">
				{moreHeading && <h3 class="h2 text-center">{moreHeading}</h3>}
				<PortfolioGrid portfolios={otherPortfolios} noTransitions />
			</section>
		)
	}
	<Contact class="mt-12" source={`case study: ${portfolio.title}`} />
</BaseLayout>
