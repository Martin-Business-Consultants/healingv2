---
/**
 * * A rounded callout with a heading, text and buttons (the CMS's built-in "cta_band" block).
 */

import Button from "@components/Button/Button.astro";
import type { CtaBandBlock } from "librepublish:types";

import { href, plainText } from "@/lib/cms";

type Props = CtaBandBlock;

const { heading, body, ctas = [], background } = Astro.props;
const variants = { primary: "primary", secondary: "outline", ghost: "ghost" } as const;
---

<section class="site-container pb-16 md:pb-24">
	<div
		class:list={[
			"flex flex-col items-start justify-between gap-6 rounded-2xl p-8 md:flex-row md:items-center md:p-10",
			background === "primary" ? "bg-primary-900 text-primary-50" : background === "accent" ? "bg-bloom/15" : "bg-primary-100",
		]}
		data-reveal
	>
		<div>
			<p class:list={["font-heading-1 text-2xl md:text-3xl", { "text-primary-950": background !== "primary" }]}>{heading}</p>
			{body && <p class="description mt-2 max-w-[36rem]">{plainText(body)}</p>}
		</div>
		{
			ctas.length > 0 && (
				<div class="flex shrink-0 flex-wrap gap-3">
					{ctas.map((cta) => (
						<Button href={href(cta.url)} variant={variants[cta.style] ?? "primary"} arrow="right">
							{cta.label}
						</Button>
					))}
				</div>
			)
		}
	</div>
</section>
