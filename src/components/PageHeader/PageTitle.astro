---
/**
 * * A plain, centred page heading (CMS block "page_title"), for pages without a photo header.
 */

interface Props {
	heading: string;
	intro?: string | null;
	style?: "title" | "statement" | null;
}

const { heading, intro, style = "title" } = Astro.props;
---

<section class="site-container pt-40 md:pt-44">
	<div class="mx-auto max-w-6xl text-center">
		<h1 class:list={[style === "statement" ? "h2 text-pretty uppercase" : "h1 description"]}>{heading}</h1>
		{intro && <p class="description mx-auto mt-6 max-w-[40rem] text-lg">{intro}</p>}
	</div>
</section>
