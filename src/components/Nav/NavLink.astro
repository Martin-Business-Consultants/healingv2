---
export interface NavItem {
	text: string;
	link: string;
}

interface Props {
	navItem: NavItem;
	class?: string;
}

const { navItem, class: className } = Astro.props as Props;
const { text, link } = navItem;
const external = /^https?:\/\//.test(link);
const current = Astro.url.pathname.replace(/(\.html|\/)$/, "") === link.replace(/\/$/, "");
---

<li>
	<a
		class:list={["nav__link--base flex w-full items-center", className]}
		href={link}
		aria-current={current ? "page" : undefined}
		target={external ? "_blank" : undefined}
		rel={external ? "noopener noreferrer" : undefined}
	>
		{text}
	</a>
</li>
