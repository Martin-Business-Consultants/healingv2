---
/**
 * * Client testimonials (CMS block "testimonials"), from the Testimonials collection in its order:
 * the first featured with its garden photo, two supporting quotes, then a booking prompt.
 */

import Button from "@components/Button/Button.astro";
import CmsImage from "@components/CmsImage/CmsImage.astro";
import type { TestimonialsBlock } from "librepublish:types";

import { href, listTestimonials, plainText } from "@/lib/cms";

type Props = TestimonialsBlock;

const { eyebrow, cta_heading, cta_body, button_label, button_link } = Astro.props;
const [featured, ...rest] = (await listTestimonials()).slice(0, 3);
const buttonHref = href(button_link);
---

<section id="testimonial" class="section">
	<div class="site-container">
		{eyebrow && <p class="eyebrow" data-reveal>{eyebrow}</p>}

		{
			featured && (
				<figure class="mt-6 grid items-center gap-10 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] lg:gap-20" data-reveal>
					<div class="min-w-0">
						<blockquote class="font-heading-1 text-base-900 text-2xl leading-[1.3] md:text-[2.4rem] md:leading-[1.25]">
							<span class="text-bloom" aria-hidden="true">“</span>
							{plainText(featured.frontmatter.quote)}
							<span class="text-bloom" aria-hidden="true">”</span>
						</blockquote>
						<figcaption class="mt-8 flex items-center gap-4">
							<span class="bg-primary-600 h-px w-10" aria-hidden="true" />
							<span class="font-heading-2 text-base-800 font-semibold">{featured.title}</span>
						</figcaption>
					</div>
					<div class="bg-base-200 aspect-[4/5] max-h-[34rem] overflow-hidden rounded-xl">
						<CmsImage
							id={featured.frontmatter.image}
							alt={`Garden designed for ${featured.title}`}
							sizes="(min-width: 1024px) 40vw, 100vw"
							class="h-full w-full object-cover"
						/>
					</div>
				</figure>
			)
		}

		{
			rest.length > 0 && (
				<div class="border-base-200 mt-16 grid gap-10 border-t pt-12 md:grid-cols-2 md:gap-14" data-reveal-group>
					{rest.map((t) => (
						<figure class="grid grid-cols-[5.5rem_minmax(0,1fr)] gap-5 sm:grid-cols-[7rem_minmax(0,1fr)] sm:gap-6">
							<div class="bg-base-200 aspect-square overflow-hidden rounded-lg">
								<CmsImage
									id={t.frontmatter.image}
									alt={`Garden designed for ${t.title}`}
									sizes="8rem"
									class="h-full w-full object-cover"
								/>
							</div>
							<div class="min-w-0">
								<blockquote class="text-base-800 text-pretty md:text-lg">“{plainText(t.frontmatter.quote)}”</blockquote>
								<figcaption class="font-heading-2 text-base-700 mt-4 text-sm font-semibold">{t.title}</figcaption>
							</div>
						</figure>
					))}
				</div>
			)
		}

		{
			cta_heading && (
				<div
					class="bg-primary-100 mt-16 flex flex-col items-start justify-between gap-6 rounded-2xl p-8 md:flex-row md:items-center md:p-10"
					data-reveal
				>
					<div>
						<p class="font-heading-1 text-primary-950 text-2xl md:text-3xl">{cta_heading}</p>
						{cta_body && <p class="description mt-2">{cta_body}</p>}
					</div>
					{button_label && buttonHref && (
						<Button href={buttonHref} variant="primary" arrow="right" class="shrink-0">
							{button_label}
						</Button>
					)}
				</div>
			)
		}
	</div>
</section>
