---
/**
 * * Client testimonials: one featured quote with its garden photo, two supporting quotes, then a booking CTA
 */

import Button from "@components/Button/Button.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

interface Props {
	ctaText?: string;
}

const { ctaText = "Book a garden consultation" } = Astro.props;

const testimonials = await getCollection("testimonials", ({ data }) => data.draft !== true);
const [featured, ...rest] = testimonials.sort((a, b) => a.data.order - b.data.order).slice(0, 3);

// names are stored in caps in the CMS; show them in title case
const displayName = (name: string) => name.toLowerCase().replace(/(^|[\s&-])\p{L}/gu, (c) => c.toUpperCase());
---

<section id="testimonial" class="section">
	<div class="site-container">
		<p class="eyebrow" data-reveal>What clients say</p>

		{
			featured && (
				<figure class="mt-6 grid items-center gap-10 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] lg:gap-20" data-reveal>
					<div class="min-w-0">
						<blockquote class="font-heading-1 text-base-900 text-2xl leading-[1.3] md:text-[2.4rem] md:leading-[1.25]">
							<span class="text-bloom" aria-hidden="true">“</span>
							{featured.data.testimonial}
							<span class="text-bloom" aria-hidden="true">”</span>
						</blockquote>
						<figcaption class="mt-8 flex items-center gap-4">
							<span class="bg-primary-600 h-px w-10" aria-hidden="true" />
							<span class="font-heading-2 text-base-800 font-semibold">{displayName(featured.data.title)}</span>
						</figcaption>
					</div>
					<div class="bg-base-200 aspect-[4/5] max-h-[34rem] overflow-hidden rounded-xl">
						<Image
							src={featured.data.image}
							alt={`Garden designed for ${displayName(featured.data.title)}`}
							width={640}
							densities={[1.5, 2]}
							class="h-full w-full object-cover"
						/>
					</div>
				</figure>
			)
		}

		<div class="border-base-200 mt-16 grid gap-10 border-t pt-12 md:grid-cols-2 md:gap-14" data-reveal-group>
			{
				rest.map((t) => (
					<figure class="grid grid-cols-[5.5rem_minmax(0,1fr)] gap-5 sm:grid-cols-[7rem_minmax(0,1fr)] sm:gap-6">
						<div class="bg-base-200 aspect-square overflow-hidden rounded-lg">
							<Image
								src={t.data.image}
								alt={`Garden designed for ${displayName(t.data.title)}`}
								width={240}
								densities={[1.5, 2]}
								class="h-full w-full object-cover"
							/>
						</div>
						<div class="min-w-0">
							<blockquote class="text-base-800 text-pretty md:text-lg">“{t.data.testimonial}”</blockquote>
							<figcaption class="font-heading-2 text-base-700 mt-4 text-sm font-semibold">
								{displayName(t.data.title)}
							</figcaption>
						</div>
					</figure>
				))
			}
		</div>

		<div
			class="bg-primary-100 mt-16 flex flex-col items-start justify-between gap-6 rounded-2xl p-8 md:flex-row md:items-center md:p-10"
			data-reveal
		>
			<div>
				<p class="font-heading-1 text-primary-950 text-2xl md:text-3xl">Ready to start on your own garden?</p>
				<p class="description mt-2">Most projects begin with a single consultation, on-site or virtual.</p>
			</div>
			<Button href="/#contact" variant="primary" arrow="right" class="shrink-0">{ctaText}</Button>
		</div>
	</div>
</section>
