---
/**
 * * A large client quote on a dark band (CMS block "pull_quote"). Left blank, it shows the
 * featured quote from Site settings.
 */

import { getSiteSettings, plainText } from "@/lib/cms";

interface Props {
	text?: string | null;
	attribution?: string | null;
}

const { text, attribution } = Astro.props;
const featured = (await getSiteSettings()).quote;
const quote = plainText(text) || featured?.text?.trim();
const name = (plainText(text) ? attribution : featured?.attribution)?.replace(/^[-–—\s]+/, "");
---

{
	quote && (
		<figure class="bg-primary-900 text-primary-50 py-16 md:py-24">
			<div class="site-container max-w-[60rem]" data-reveal>
				<span class="font-heading-1 text-bloom block text-7xl leading-[0.5]" aria-hidden="true">
					“
				</span>
				<blockquote class="font-heading-1 mt-4 text-2xl leading-snug md:text-4xl md:leading-snug">{quote}</blockquote>
				{name && <figcaption class="font-heading-2 text-primary-200 mt-8 font-semibold">{name}</figcaption>}
			</div>
		</figure>
	)
}
