---
interface Props {
	quoteText?: string;
	attribution?: string;
}

const {
	quoteText = "Sarah created a stunning design for my rain garden. It really brought the project to life and helped me imagine what the space would look like when finished.",
	attribution = "- Emily D.",
} = Astro.props;

const name = attribution.replace(/^[-–—\s]+/, "");
---

<figure class="bg-primary-900 text-primary-50 py-16 md:py-24">
	<div class="site-container max-w-[60rem]" data-reveal>
		<span class="font-heading-1 text-bloom block text-7xl leading-[0.5]" aria-hidden="true">“</span>
		<blockquote class="font-heading-1 mt-4 text-2xl leading-snug md:text-4xl md:leading-snug">
			{quoteText.trim()}
		</blockquote>
		<figcaption class="font-heading-2 text-primary-200 mt-8 font-semibold">{name}</figcaption>
	</div>
</figure>
