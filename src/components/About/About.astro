---
/**
 * * About intro (CMS block "about_intro"): a portrait beside a short introduction and sign-off.
 */

import Button from "@components/Button/Button.astro";
import CmsImage from "@components/CmsImage/CmsImage.astro";
import type { AboutIntroBlock } from "librepublish:types";

import { href, richText } from "@/lib/cms";

type Props = AboutIntroBlock;

const { eyebrow, heading, body, signoff, image, button_label, button_link } = Astro.props;
const buttonHref = href(button_link);
---

<section id="about" class="section">
	<div class="site-container grid items-center gap-12 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20">
		<div class="bg-base-200 aspect-[4/5] max-w-md overflow-hidden rounded-xl md:max-w-none" data-reveal>
			<CmsImage id={image} sizes="(min-width: 768px) 40vw, 100vw" class="h-full w-full object-cover" />
		</div>
		<div class="min-w-0" data-reveal>
			{eyebrow && <p class="eyebrow">{eyebrow}</p>}
			<h2 class="h2 mt-3">{heading}</h2>
			<div class="description prose-cms mt-6 max-w-[36rem] text-lg" set:html={richText(body)} />
			{signoff && <p class="font-heading-1 text-primary-800 mt-6 text-3xl italic">{signoff}</p>}
			{
				button_label && buttonHref && (
					<div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
						<Button href={buttonHref} variant="outline" arrow="right">
							{button_label}
						</Button>
					</div>
				)
			}
		</div>
	</div>
</section>
