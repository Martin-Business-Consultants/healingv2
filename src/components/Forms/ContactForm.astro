---
import Button from "@components/Button/Button.astro";
import { getCollection } from "astro:content";

interface Props {
	compact?: boolean; // tighter version for the hero card
	selected?: string; // service id to preselect, e.g. on a service page
	source?: string; // which page or campaign the request came from
}

const { compact = false, selected, source = "website" } = Astro.props as Props;

const services = (await getCollection("services", ({ data }) => data.draft !== true)).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<form
	id="contact-form"
	name="contact"
	method="POST"
	data-netlify="true"
	netlify-honeypot="bot-field"
	class:list={["flex flex-col", compact ? "gap-4" : "gap-5"]}
>
	<input type="hidden" name="form-name" value="contact" />
	<input type="hidden" name="source" value={source} />
	<p class="hidden">
		<label>Leave this empty: <input name="bot-field" /></label>
	</p>

	<div class="grid gap-5 sm:grid-cols-2">
		<div>
			<label for="contact-name" class="form__label font-heading-2 text-sm font-semibold">Your name</label>
			<input type="text" class="form__input" name="name" id="contact-name" autocomplete="name" required />
		</div>
		<div>
			<label for="contact-email" class="form__label font-heading-2 text-sm font-semibold">Email</label>
			<input
				type="email"
				class="form__input"
				name="email"
				id="contact-email"
				inputmode="email"
				autocomplete="email"
				required
			/>
		</div>
	</div>

	<div>
		<label for="contact-service" class="form__label font-heading-2 text-sm font-semibold">
			What are you interested in?
		</label>
		<select name="service" id="contact-service" class="form__input">
			{
				services.map((service) => (
					<option value={service.id} selected={service.id === selected}>
						{service.data.name}
					</option>
				))
			}
			<option value="not-sure">Not sure yet</option>
		</select>
	</div>

	<div class:list={[{ hidden: compact }]}>
		<label for="contact-date" class="form__label font-heading-2 text-sm font-semibold">
			Preferred date <span class="text-base-500 font-normal">(optional)</span>
		</label>
		<input type="date" class="form__input" name="date" id="contact-date" />
	</div>

	<div>
		<label for="contact-message" class="form__label font-heading-2 text-sm font-semibold">
			Tell me about your space
		</label>
		<textarea
			name="message"
			class="form__input"
			id="contact-message"
			rows={compact ? 3 : 5}
			placeholder="Sun and shade, roughly how big it is, and what you'd love to grow"
			required></textarea>
	</div>

	<div class:list={["flex flex-col gap-3", { "sm:flex-row sm:items-center sm:gap-5": !compact }]}>
		<Button variant="primary" type="submit" arrow="right" class={compact ? "w-full" : "w-full sm:w-fit"}>
			Send my request
		</Button>
		{!compact && <p class="text-base-600 text-sm">I'll reply within 1–2 business days.</p>}
	</div>
</form>

<script>
	// preselect the service when arriving from a pricing card (/?service=<id>#contact)
	function preselectService() {
		const select = document.getElementById("contact-service") as HTMLSelectElement | null;
		const service = new URLSearchParams(window.location.search).get("service");
		if (select && service && select.querySelector(`option[value="${CSS.escape(service)}"]`)) {
			select.value = service;
		}
	}

	preselectService();
	document.addEventListener("astro:page-load", preselectService);
</script>
