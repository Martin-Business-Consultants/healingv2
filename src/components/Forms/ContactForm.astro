---
/**
 * * The CMS's "contact" form (Forms plugin), in the site's design. The browser posts straight to
 * the CMS, which checks the honeypot, its rate limit, Turnstile (when Settings › Forms has keys)
 * and the form's field rules, then sends its notification and confirmation emails.
 *
 * Fields, labels, placeholders, the button and the thank-you message all come from the form in
 * the CMS. A few fields are drawn specially, by name:
 *   service      a select of every published service (Services collection), plus "Not sure yet"
 *   *date        a date picker
 *   source       hidden: the page or campaign the request came from
 */
import Button from "@components/Button/Button.astro";

import { getForm, getSiteSettings, listServices } from "@/lib/cms";

interface Props {
	compact?: boolean; // tighter version for the hero card: optional extras are left out
	selected?: string | null; // service slug to preselect, e.g. on a service page
	source?: string | null; // which page or campaign the request came from
}

const { compact = false, selected, source } = Astro.props as Props;

const [form, services, settings] = await Promise.all([getForm("contact"), listServices(), getSiteSettings()]);
const id = `contact-form${compact ? "-compact" : ""}`;
const turnstileKey = form.captcha?.provider === "turnstile" ? form.captcha.site_key : "";

// pairs of short fields (name + email) sit side by side on wider screens
const isShort = (type: string) => ["text", "email", "tel", "url"].includes(type);
const visible = form.fields.filter((field) => field.name !== "source" && !(compact && !field.required && field.name !== "service"));
---

<form
	id={id}
	method="post"
	action={form.action}
	data-contact-form
	data-honeypot={form.honeypot}
	data-success={form.success_message ?? ""}
	class:list={["flex flex-col", compact ? "gap-4" : "gap-5"]}
>
	<input type="hidden" name="source" value={source || "website"} />
	<p hidden aria-hidden="true">
		<label>Leave this empty: <input name={form.honeypot} tabindex="-1" autocomplete="off" /></label>
	</p>

	<div class="grid gap-5 sm:grid-cols-2">
		{
			visible.map((field) => {
				const fieldId = `${id}-${field.name}`;
				const wide = !(isShort(field.type) && !/date$/.test(field.name) && field.name !== "service");
				const label = (
					<label for={fieldId} class="form__label font-heading-2 text-sm font-semibold">
						{field.label}
						{!field.required && field.name !== "service" && (
							<span class="text-base-500 font-normal"> (optional)</span>
						)}
					</label>
				);
				return (
					<div class:list={[{ "sm:col-span-2": wide }]}>
						{label}
						{field.name === "service" ? (
							<select name={field.name} id={fieldId} class="form__input" required={field.required}>
								{services.map((service) => (
									<option value={service.title} data-slug={service.slug} selected={service.slug === selected}>
										{service.title}
									</option>
								))}
								<option value="Not sure yet" data-slug="not-sure">
									Not sure yet
								</option>
							</select>
						) : field.type === "textarea" ? (
							<textarea
								name={field.name}
								id={fieldId}
								class="form__input"
								rows={compact ? 3 : 5}
								placeholder={field.placeholder}
								required={field.required}
							/>
						) : field.type === "select" ? (
							<select name={field.name} id={fieldId} class="form__input" required={field.required}>
								{(field.options ?? []).map((option) => (
									<option value={option.value}>{option.label}</option>
								))}
							</select>
						) : (
							<input
								type={/date$/.test(field.name) ? "date" : field.type}
								name={field.name}
								id={fieldId}
								class="form__input"
								placeholder={field.placeholder}
								required={field.required}
								autocomplete={field.type === "email" ? "email" : field.name === "name" ? "name" : undefined}
								inputmode={field.type === "email" ? "email" : undefined}
							/>
						)}
						<p class="mt-1.5 text-sm text-red-700" data-error-for={field.name} data-label={field.label} hidden />
					</div>
				);
			})
		}
	</div>

	{turnstileKey && <div class="cf-turnstile" data-sitekey={turnstileKey} data-appearance="interaction-only" />}

	<div class:list={["flex flex-col gap-3", { "sm:flex-row sm:items-center sm:gap-5": !compact }]}>
		<Button variant="primary" type="submit" arrow="right" class={compact ? "w-full" : "w-full sm:w-fit"}>
			{form.submit_label || "Send"}
		</Button>
		{!compact && settings.contact?.note && <p class="text-base-600 text-sm">{settings.contact.note}</p>}
	</div>
	<p data-form-status role="status" aria-live="polite" class="text-primary-800 font-medium" hidden></p>
</form>

{turnstileKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />}

<script>
	const FALLBACK = "Couldn't send that. Please check your connection and try again.";
	const MESSAGES: Record<string, string> = {
		captcha_failed: "Please complete the check and try again.",
		rate_limited: "Too many tries. Please wait a few minutes and try again.",
	};

	// preselect the service when arriving from a link like /?service=<slug>#contact
	function preselectService(form: HTMLFormElement) {
		const select = form.querySelector<HTMLSelectElement>('select[name="service"]');
		const slug = new URLSearchParams(window.location.search).get("service");
		const option = slug && select?.querySelector<HTMLOptionElement>(`option[data-slug="${CSS.escape(slug)}"]`);
		if (select && option) select.value = option.value;
	}

	function initContactForms() {
		document.querySelectorAll<HTMLFormElement>("form[data-contact-form]").forEach((form) => {
			if (form.dataset.ready) return;
			form.dataset.ready = "1";
			preselectService(form);

			form.addEventListener("submit", async (event) => {
				event.preventDefault();
				const status = form.querySelector<HTMLElement>("[data-form-status]")!;
				const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
				const data = new FormData(form);
				form.querySelectorAll<HTMLElement>("[data-error-for]").forEach((el) => {
					el.hidden = true;
					el.textContent = "";
				});

				// Honeypot: bots fill the hidden field; pretend it worked. A bot that skips this
				// script still posts it, and the CMS drops the submission.
				const honeypot = form.dataset.honeypot;
				const done = () => {
					form.reset();
					status.textContent = form.dataset.success || "Thank you!";
					status.hidden = false;
				};
				if (honeypot && String(data.get(honeypot) ?? "").trim()) return done();

				if (button) button.disabled = true;
				status.hidden = true;
				try {
					const response = await fetch(form.action, { method: "POST", body: data, headers: { Accept: "application/json" } });
					const body = await response.json().catch(() => ({}));
					if (response.ok) return done();
					for (const [name, messages] of Object.entries((body.errors ?? {}) as Record<string, string[]>)) {
						const el = form.querySelector<HTMLElement>(`[data-error-for="${CSS.escape(name)}"]`);
						if (!el) continue;
						// The CMS says "is required"; the field's label makes it a sentence.
						el.textContent = messages.map((message) => `${el.dataset.label ?? name} ${message}.`).join(" ");
						el.hidden = false;
					}
					status.textContent = MESSAGES[body.error] ?? (body.errors ? "Please check the highlighted fields." : FALLBACK);
					status.hidden = false;
				} catch {
					status.textContent = FALLBACK;
					status.hidden = false;
				} finally {
					if (button) button.disabled = false;
					// A Turnstile token is single-use; get a fresh one for the next try.
					const widget = form.querySelector<HTMLElement>(".cf-turnstile");
					if (widget) (window as any).turnstile?.reset(widget);
				}
			});
		});
	}

	initContactForms();
	document.addEventListener("astro:page-load", initContactForms);
</script>
