---
/**
 * * Featured case study on the left, two more stacked on the right
 */

import Button from "@components/Button/Button.astro";
import PortfolioCard from "@components/PortfolioCard/PortfolioCard.astro";
import { getCollection } from "astro:content";

interface Props {
	heading?: string;
}

const { heading = "Gardens designed with intention, rooted in ecology." } = Astro.props;

const portfolios = await getCollection("portfolios", ({ data }) => data.draft !== true);
const [featured, ...rest] = portfolios.sort((a, b) => a.data.order - b.data.order).slice(0, 3);
---

<section id="portfolio" class="section bg-base-100">
	<div class="site-container">
		<div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
			<div>
				<p class="eyebrow">Case studies</p>
				<h2 class="h2 mt-3 max-w-[20ch]">{heading}</h2>
			</div>
			<Button href="/portfolio/" variant="outline" arrow="right">View all case studies</Button>
		</div>

		<div class="mt-12 grid gap-12 md:mt-16 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:gap-16">
			{featured && <div data-reveal><PortfolioCard portfolio={featured} direction="vertical" featured /></div>}
			<div class="grid content-center gap-12" data-reveal-group>
				{rest.map((portfolio) => <PortfolioCard portfolio={portfolio} direction="horizontal" />)}
			</div>
		</div>
	</div>
</section>
