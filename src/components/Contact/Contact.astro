---
/**
 * * Contact section for the website
 */

import ContactForm from "@components/Forms/ContactForm.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import type { ImageMetadata } from "astro";

interface Props {
	class?: string;
	heading?: string;
	description?: string;
	image?: ImageMetadata;
	selected?: string; // service id to preselect in the form
	source?: string; // page or campaign the request came from
}

const {
	class: className,
	heading = "Let's plan your garden",
	description = "Tell me a little about your space and what you'd like to grow. I reply within 1–2 business days, and most projects start with a garden consultation, on-site or virtual.",
	image,
	selected,
	source,
} = Astro.props;

const contactImage = image ?? (await import("@assets/images/IMG_0024.webp")).default;
---

<section id="contact" class:list={["section bg-primary-50", className]}>
	<div class="site-container grid items-start gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-20">
		<div class="min-w-0" data-reveal>
			<p class="eyebrow">Contact</p>
			<h2 class="h2 mt-3">{heading}</h2>
			<p class="description mt-5 max-w-[32rem] text-lg">{description}</p>

			<ul class="mt-8 flex flex-col gap-4">
				<li class="flex items-center gap-3">
					<Icon name="tabler:clock" class="text-primary-600 size-5 shrink-0" aria-hidden="true" />
					<span>Replies within 1–2 business days</span>
				</li>
				<li class="flex items-center gap-3">
					<Icon name="tabler:map-pin" class="text-primary-600 size-5 shrink-0" aria-hidden="true" />
					<span>Consultations on-site or virtual</span>
				</li>
				<li class="flex items-center gap-3">
					<Icon name="tabler:plant-2" class="text-primary-600 size-5 shrink-0" aria-hidden="true" />
					<span>No obligation to book a design</span>
				</li>
			</ul>

			<div class="bg-base-200 mt-10 hidden aspect-[4/3] overflow-hidden rounded-xl lg:block">
				<Image
					src={contactImage}
					alt="A finished garden by Healing Earth Design"
					width={560}
					densities={[1.5, 2]}
					class="h-full w-full object-cover"
				/>
			</div>
		</div>
		<div class="bg-base-50 border-base-200 min-w-0 rounded-2xl border p-6 shadow-[0_24px_60px_-36px_var(--color-primary-900)] md:p-10" data-reveal>
			<ContactForm selected={selected} source={source} />
		</div>
	</div>
</section>
