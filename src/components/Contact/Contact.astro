---
/**
 * * Contact section: copy, highlights and a photo beside the contact form. Everything defaults to
 * Site settings › Contact section in the CMS; a Contact form block can override the heading and
 * description, preselect a service and name the source.
 */

import CmsImage from "@components/CmsImage/CmsImage.astro";
import ContactForm from "@components/Forms/ContactForm.astro";
import { Icon } from "astro-icon/components";

import { getSiteSettings } from "@/lib/cms";

interface Props {
	class?: string;
	heading?: string | null;
	description?: string | null;
	selected?: string | null; // service slug to preselect in the form
	source?: string | null; // page or campaign the request came from
}

const { class: className, heading, description, selected, source } = Astro.props;
const contact = (await getSiteSettings()).contact;
const icons = ["tabler:clock", "tabler:map-pin", "tabler:plant-2"];
---

<section id="contact" class:list={["section bg-primary-50 scroll-mt-16", className]}>
	<div class="site-container grid items-start gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-20">
		<div class="min-w-0" data-reveal>
			{contact?.eyebrow && <p class="eyebrow">{contact.eyebrow}</p>}
			<h2 class="h2 mt-3">{heading || contact?.heading}</h2>
			{
				(description || contact?.description) && (
					<p class="description mt-5 max-w-[32rem] text-lg">{description || contact?.description}</p>
				)
			}

			{
				contact?.highlights?.length ? (
					<ul class="mt-8 flex flex-col gap-4">
						{contact.highlights.map((item, i) => (
							<li class="flex items-center gap-3">
								<Icon name={icons[i % icons.length]} class="text-primary-600 size-5 shrink-0" aria-hidden="true" />
								<span>{item}</span>
							</li>
						))}
					</ul>
				) : null
			}

			<div class="bg-base-200 mt-10 hidden aspect-[4/3] overflow-hidden rounded-xl lg:block">
				<CmsImage id={contact?.image} sizes="(min-width: 1024px) 34rem, 100vw" class="h-full w-full object-cover" />
			</div>
		</div>
		<div
			class="bg-base-50 border-base-200 min-w-0 rounded-2xl border p-6 shadow-[0_24px_60px_-36px_var(--color-primary-900)] md:p-10"
			data-reveal
		>
			<ContactForm selected={selected} source={source} />
		</div>
	</div>
</section>
