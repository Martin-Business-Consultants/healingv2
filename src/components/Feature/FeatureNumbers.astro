---
/**
 * * This is a "What I Do" services overview section.
 */

interface FeatureCardData {
	largeText: string;
	description: string;
}

interface Props {
	heading?: string;
	tagline?: string;
	missionStatement?: string;
	items?: FeatureCardData[];
}

const {
	heading = "What I Do",
	tagline = "All services are plant-forward and tailored to your space, lifestyle, and experience level.",
	missionStatement = "My mission is to help bridge the gap between wild spaces and our cities by transforming everyday yards into living ecosystems—places that nurture plants, people, and wildlife alike.",
	items = [
		{ largeText: "Consult", description: "Garden consultations and seasonal guidance" },
		{ largeText: "Design", description: "Custom planting plans and landscape design drawings" },
		{ largeText: "Grow", description: "Native, pollinator, vegetable, cut flower, and medicinal herb gardens" },
		{ largeText: "Support", description: "Plant shopping and installation support" },
	],
} = Astro.props;
---

<section id="feature-numbers" class="section">
	<div class="site-container">
		<div class="grid gap-6 lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-16">
			<p class="eyebrow pt-3" data-reveal>{heading}</p>
			<div data-reveal>
				<h2 class="h2 max-w-[22ch] md:max-w-[26ch]">{missionStatement}</h2>
				<p class="description mt-6 max-w-[40rem] text-lg">{tagline}</p>
			</div>
		</div>

		<div class="bg-base-300 mt-14 h-px md:mt-20" data-grow-x></div>
		<div id="feature-numbers-cards" class="grid gap-x-10 gap-y-10 pt-10 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
			{
				items.map((feature) => (
					<div class="flex flex-col gap-3">
						<h3 class="font-heading-1 text-primary-700 text-4xl leading-none italic md:text-5xl">
							{feature.largeText}
						</h3>
						<p class="description max-w-[22rem] text-base md:text-lg">{feature.description}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
