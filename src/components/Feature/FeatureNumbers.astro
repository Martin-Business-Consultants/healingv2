---
/**
 * * "What I Do" (CMS block "what_i_do"): a mission statement with a row of large-type themes.
 */

import type { WhatIDoBlock } from "librepublish:types";

type Props = WhatIDoBlock;

const { eyebrow, statement, tagline, items = [] } = Astro.props;
---

<section id="feature-numbers" class="section">
	<div class="site-container">
		<div class="grid gap-6 lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-16">
			<p class="eyebrow pt-3" data-reveal>{eyebrow}</p>
			<div data-reveal>
				<h2 class="h2 max-w-[22ch] md:max-w-[26ch]">{statement}</h2>
				{tagline && <p class="description mt-6 max-w-[40rem] text-lg">{tagline}</p>}
			</div>
		</div>

		{
			items?.length ? (
				<Fragment>
					<div class="bg-base-300 mt-14 h-px md:mt-20" data-grow-x />
					<div id="feature-numbers-cards" class="grid gap-x-10 gap-y-10 pt-10 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
						{items.map((feature) => (
							<div class="flex flex-col gap-3">
								<h3 class="font-heading-1 text-primary-700 text-4xl leading-none italic md:text-5xl">{feature.large_text}</h3>
								{feature.description && <p class="description max-w-[22rem] text-base md:text-lg">{feature.description}</p>}
							</div>
						))}
					</div>
				</Fragment>
			) : null
		}
	</div>
</section>
