---
// Page not found. Its words are in Site settings › Page not found in the CMS.
import Button from "@components/Button/Button.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

import { getSiteSettings } from "@/lib/cms";

const notFound = (await getSiteSettings()).not_found ?? {};
const heading = notFound.heading || "Page not found";
const record = {
	title: heading,
	locale: "en",
	translations: [],
	seo: { meta_title: heading, meta_description: notFound.body ?? undefined, noindex: true },
} as any;
---

<BaseLayout record={record}>
	<section class="site-container pt-36 text-center md:pt-44">
		<div class="mx-auto max-w-xl px-4 text-center">
			<h1 class="h1">{heading}</h1>
			{notFound.body && <p class="description mt-4">{notFound.body}</p>}
			<div class="mt-8 flex justify-center">
				<Button variant="primary" href="/">{notFound.button_label || "Go to homepage"}</Button>
			</div>
		</div>
	</section>
</BaseLayout>
