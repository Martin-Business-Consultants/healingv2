---
/**
 * Each form email (notification and confirmation) in the site's design. cms() sends what this
 * builds to the CMS after `astro build` and leaves it out of the deployed site; the CMS fills in
 * the {{tokens}}, repeats the answersRow once per answer, and sends the email. The words and
 * blocks are edited in the CMS (Forms › the form › Emails); this is only the design.
 *
 * Email clients need tables and inline styles, so this page uses nothing else.
 */
import {
	answersRow,
	type CmsEmailBlock,
	type CmsFormEmail,
	digestMeta,
	emailTemplatePaths,
} from "@librepublish/astro/forms";

import { siteName } from "@/lib/site";

export const prerender = true;
export const getStaticPaths = emailTemplatePaths;

const { email } = Astro.props as { email: CmsFormEmail };
const blocks = email.blocks as CmsEmailBlock[];
const name = await siteName();
const site = Astro.site?.href.replace(/\/$/, "") ?? "";

// The site's palette (src/styles/tailwind-theme.css), as hex for email clients.
const c = {
	page: "#f1f4ee",
	card: "#fbfcf9",
	ink: "#262f28",
	muted: "#4b564d",
	rule: "#dde2da",
	green: "#2c4834",
	deep: "#1f3326",
	tint: "#eef3eb",
	bloom: "#d4513f",
};
const serif = "'Playfair Display', Georgia, 'Times New Roman', serif";
const sans = "'Work Sans', 'Helvetica Neue', Helvetica, Arial, sans-serif";
const sizes = { h1: "30px", h2: "24px", h3: "20px" } as const;
const spacer = { small: 12, medium: 24, large: 40 } as const;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta {...digestMeta(email)} />
		<title>{email.subject}</title>
	</head>
	<body style={`margin:0;padding:0;background:${c.page};`}>
		<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style={`background:${c.page};`}>
			<tr>
				<td align="center" style="padding:32px 16px;">
					<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;">
						<tr>
							<td style={`padding:0 8px 20px;font-family:${serif};font-size:18px;letter-spacing:2px;text-transform:uppercase;color:${c.green};`}>
								<a href={site} style={`color:${c.green};text-decoration:none;`}>{name}</a>
							</td>
						</tr>
						<tr>
							<td style={`background:${c.card};border:1px solid ${c.rule};border-top:4px solid ${c.green};border-radius:12px;padding:36px 36px 28px;`}>
								<table role="presentation" width="100%" cellpadding="0" cellspacing="0">
									{
										blocks.map((block) => {
											switch (block.type) {
												case "email_heading": {
													const level = block.data.level ?? "h1";
													return (
														<tr>
															<td
																align={block.data.align ?? "left"}
																style={`padding:0 0 16px;font-family:${serif};font-size:${sizes[level]};line-height:1.25;font-weight:500;color:${c.ink};`}
															>
																{block.data.text}
															</td>
														</tr>
													);
												}
												case "email_text":
													return (
														<tr>
															<td
																style={`padding:0 0 16px;font-family:${sans};font-size:16px;line-height:1.6;color:${c.muted};`}
																set:html={block.data.body}
															/>
														</tr>
													);
												case "email_button":
													return (
														<tr>
															<td align={block.data.align ?? "left"} style="padding:8px 0 24px;">
																<a
																	href={block.data.url}
																	style={`display:inline-block;background:${c.green};color:#ffffff;font-family:${sans};font-size:15px;font-weight:600;text-decoration:none;padding:13px 24px;border-radius:999px;`}
																>
																	{block.data.label} &rarr;
																</a>
															</td>
														</tr>
													);
												case "email_image":
													return block.resolved?.url ? (
														<tr>
															<td align={block.data.align ?? "left"} style="padding:0 0 20px;">
																{block.data.url ? (
																	<a href={block.data.url}>
																		<img src={block.resolved.url} alt={block.data.alt ?? ""} width="526" style="display:block;width:100%;max-width:526px;height:auto;border-radius:8px;border:0;" />
																	</a>
																) : (
																	<img src={block.resolved.url} alt={block.data.alt ?? ""} width="526" style="display:block;width:100%;max-width:526px;height:auto;border-radius:8px;border:0;" />
																)}
															</td>
														</tr>
													) : null;
												case "email_divider":
													return (
														<tr>
															<td style="padding:8px 0 24px;">
																<div style={`border-top:1px solid ${c.rule};font-size:0;line-height:0;`}>&nbsp;</div>
															</td>
														</tr>
													);
												case "email_spacer":
													return (
														<tr>
															<td style={`height:${spacer[block.data.size ?? "medium"]}px;font-size:0;line-height:0;`}>&nbsp;</td>
														</tr>
													);
												case "email_submission":
													return (
														<tr>
															<td style="padding:0 0 16px;">
																{block.data.title && (
																	<p style={`margin:0 0 10px;font-family:${sans};font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:${c.green};`}>
																		{block.data.title}
																	</p>
																)}
																<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style={`background:${c.tint};border-radius:8px;`}>
																	<tr {...answersRow(block)}>
																		<td valign="top" style={`padding:10px 14px;width:38%;font-family:${sans};font-size:13px;font-weight:600;color:${c.green};border-bottom:1px solid ${c.rule};`}>
																			{"{{answer.label}}"}
																		</td>
																		<td valign="top" style={`padding:10px 14px;font-family:${sans};font-size:15px;line-height:1.5;color:${c.ink};border-bottom:1px solid ${c.rule};`}>
																			{"{{answer.value}}"}
																		</td>
																	</tr>
																</table>
															</td>
														</tr>
													);
												default:
													return null;
											}
										})
									}
								</table>
							</td>
						</tr>
						<tr>
							<td align="center" style={`padding:20px 8px 0;font-family:${sans};font-size:12px;line-height:1.5;color:${c.muted};`}>
								{name} &middot; <a href={site} style={`color:${c.muted};`}>{site.replace(/^https?:\/\//, "")}</a>
							</td>
						</tr>
					</table>
				</td>
			</tr>
		</table>
	</body>
</html>
