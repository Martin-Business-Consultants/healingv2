---
import Button from "@components/Button/Button.astro";
import Contact from "@components/Contact/Contact.astro";
import PageHeader from "@components/PageHeader/PageHeader.astro";
import TestimonialQuote from "@components/Testimonials/TestimonialQuote.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import headerImage from "@assets/images/IMG_2680.webp";
import fallData from "@/data/pages/fall-planning.json";
import homeData from "@/data/pages/home.json";

const hasOffer = Boolean(fallData.offer.text?.trim());
---

<BaseLayout title={fallData.pageTitle} description={fallData.pageDescription} navStartStyle="white">
	<PageHeader
		eyebrow={fallData.eyebrow}
		title={fallData.heading}
		intro={fallData.intro}
		image={headerImage}
		imagePosition="50% 35%"
	>
		<Button href="#contact" variant="secondary" arrow="right">Book a fall consultation</Button>
	</PageHeader>

	{
		hasOffer && (
			<section class="site-container -mt-8 md:-mt-10">
				<div class="bg-base-50 border-bloom relative rounded-2xl border-l-4 p-7 shadow-[0_24px_60px_-36px_var(--color-primary-900)] md:p-9" data-reveal>
					<p class="eyebrow text-bloom">{fallData.offer.heading}</p>
					<p class="font-heading-1 text-base-900 mt-3 max-w-[48rem] text-2xl leading-snug md:text-3xl">
						{fallData.offer.text}
					</p>
				</div>
			</section>
		)
	}

	<section class="section">
		<div class="site-container">
			<div data-reveal>
				<p class="eyebrow">Why plan in fall</p>
				<h2 class="h2 mt-3 max-w-[22ch]">The best garden plans start at the end of a season</h2>
			</div>
			<div class="mt-12 grid gap-10 md:grid-cols-3" data-reveal-group>
				{
					fallData.reasons.map((reason) => (
						<div class="border-base-300 border-t pt-6">
							<h3 class="font-heading-1 text-primary-800 text-2xl leading-tight">{reason.title}</h3>
							<p class="description mt-3">{reason.text}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="section bg-base-100">
		<div class="site-container">
			<div data-reveal>
				<p class="eyebrow">From fall to spring</p>
				<h2 class="h2 mt-3">How it comes together</h2>
			</div>
			<ol class="mt-12 grid gap-10 md:grid-cols-3" data-reveal-group>
				{
					fallData.steps.map((step) => (
						<li class="bg-base-50 border-base-200 rounded-2xl border p-7">
							<p class="font-heading-1 text-bloom text-4xl italic">{step.season}</p>
							<h3 class="h3 text-base-900 mt-4">{step.title}</h3>
							<p class="description mt-2">{step.text}</p>
						</li>
					))
				}
			</ol>
			<div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4" data-reveal>
				<Button href="#contact" variant="primary" arrow="right">Book a fall consultation</Button>
				<a href="/services/" class="font-heading-2 text-primary-800 font-semibold underline decoration-1 underline-offset-[6px]">
					See all services
				</a>
			</div>
		</div>
	</section>

	<TestimonialQuote quoteText={homeData.testimonialQuote.quoteText} attribution={homeData.testimonialQuote.attribution} />

	<Contact
		heading="Start your spring garden this fall"
		description="Tell me about your space and what you'd like to grow next year. I reply within 1–2 business days."
		selected="garden-consultation"
		source="fall-planning"
	/>
</BaseLayout>
